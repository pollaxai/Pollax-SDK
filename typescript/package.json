{
  "name": "@pollax/sdk",
  "version": "1.1.0",
  "description": "Official Pollax SDK for TypeScript/JavaScript",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pollax",
    "ai",
    "voice",
    "calling",
    "telephony",
    "speech",
    "customer-service"
  ],
  "author": "Pollax <support@pollax.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pollaxai/Pollax-SDK.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/pollaxai/Pollax-SDK/issues"
  },
  "homepage": "https://pollax.ai",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
